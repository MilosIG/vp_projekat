<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<system.serviceModel>
		<client>
			<endpoint
				name="PpgService"
				address="net.tcp://localhost:4000/PpgService"
				binding="netTcpBinding"
				contract="GalaxyPPG.Common.IPpgService" />
		</client>
	</system.serviceModel>
</configuration>