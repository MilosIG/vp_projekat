<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<add key="HrMinBpm" value="50" />
		<add key="HrMaxBpm" value="180" />
		<add key="AccMotionThreshold" value="20" />
		<add key="IbiOutOfRangePct" value="0.2" />
		<add key="PpgMinSignalThreshold" value="0.01" />
		<add key="WeakPpgConsecutiveRows" value="5" />
	</appSettings>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<system.serviceModel>
		<services>
			<service name="GalaxyPPG.Server.PpgService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:4000" />
					</baseAddresses>
				</host>

				<endpoint
					address="PpgService"
					binding="netTcpBinding"
					bindingConfiguration="tcpBindingConfig"
					contract="GalaxyPPG.Common.IPpgService" />
			</service>
		</services>

		<bindings>
			<netTcpBinding>
				<binding
					name="tcpBindingConfig"
					transferMode="Streamed"
					maxReceivedMessageSize="10485760"
					maxBufferSize="10485760" />
			</netTcpBinding>
		</bindings>
		
	</system.serviceModel>
</configuration>
